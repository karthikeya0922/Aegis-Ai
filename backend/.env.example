# Aegis Inspector -- environment template.
# Copy to .env and fill in. Never commit .env.

# --- Service ---------------------------------------------------------------
ENVIRONMENT=development

# --- Storage ---------------------------------------------------------------
# SQLite is the zero-setup default. Swap to Postgres with:
#   DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
DATABASE_URL=sqlite:///./aegis.db

# --- Policy ----------------------------------------------------------------
AEGIS_MODE=sanitize
AEGIS_POLICY_PROFILE=default

# Secrets are never rehydrated into a response. Declared here so the value is
# explicit in config rather than implicit in code; the egress path ignores a
# `true` value by design.
AEGIS_SECRET_REHYDRATION=false
AEGIS_PII_REHYDRATION=true

# --- Detection thresholds --------------------------------------------------
AEGIS_INJECTION_THRESHOLD=0.75
AEGIS_PII_MIN_CONFIDENCE=0.50
AEGIS_ENTROPY_THRESHOLD=4.0
AEGIS_ENTROPY_MIN_LENGTH=20

# --- Grounded verification -------------------------------------------------
AEGIS_GROUNDING_REVIEW_BELOW=0.75
AEGIS_GROUNDING_REPLACE_BELOW=0.50

# --- Models ----------------------------------------------------------------
AEGIS_EMBEDDING_MODEL=all-MiniLM-L6-v2
AEGIS_EMBEDDING_DIM=384
AEGIS_NLI_MODEL=cross-encoder/nli-deberta-v3-small
AEGIS_SPACY_MODEL=en_core_web_lg
# Warm models at startup so demo-day cold start is not a risk.
AEGIS_WARM_MODELS=false

# --- Vault -----------------------------------------------------------------
AEGIS_VAULT_TTL_SECONDS=300

# --- Cache hints -----------------------------------------------------------
# A request that contained personal data is not cacheable by default, even
# after sanitisation. See config/routing.yaml.
AEGIS_CACHE_ALLOW_PII=false

# --- Privacy of our own audit log ------------------------------------------
# REQUIRED in any shared environment. User identifiers are HMAC'd with this
# salt before they touch the database; changing it makes old hashes unlinkable.
AEGIS_USER_HASH_SALT=change-me-to-a-long-random-value
AEGIS_AUDIT_RETENTION_DAYS=30

# --- Human oversight -------------------------------------------------------
AEGIS_OVERRIDE_TOKEN_TTL_SECONDS=900

# --- Transport -------------------------------------------------------------
AEGIS_MAX_REQUEST_BYTES=256000
AEGIS_CORS_ORIGINS=http://localhost:3000
