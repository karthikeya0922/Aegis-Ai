# Aegis Engine Configuration
AEGIS_ENGINE_URL=http://python-engine:8000
AEGIS_SCAN_TIMEOUT_MS=3000
AEGIS_VERIFY_TIMEOUT_MS=3000

# Redis Config
REDIS_URL=redis://redis-stack:6379

# PostgreSQL Database (used by backend)
DATABASE_URL=postgresql://aegis:aegis@postgres:5432/aegis

# Provider API Keys
GLM_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# Provider Config
AEGIS_PROVIDER_HOST_ALLOWLIST=
AEGIS_PROVIDER_ALLOW_PRIVATE_IPS=false
AEGIS_PROVIDERS_CONFIG_PATH=

# Circuit Breaker Tuning
AEGIS_BREAKER_FAILURE_THRESHOLD=3
AEGIS_BREAKER_OPEN_DURATION_MS=30000
AEGIS_BREAKER_HALF_OPEN_TRIALS=1
AEGIS_PROVIDER_CONNECT_TIMEOUT_MS=2500
AEGIS_PROVIDER_TOTAL_TIMEOUT_MS=120000

# Next.js Settings
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
